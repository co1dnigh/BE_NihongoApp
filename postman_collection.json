            "body": {
              "mode": "raw",
              "raw": "{\n  \"totalQuestions\": 20,\n  \"totalCorrect\": 10,\n  \"totalMistakes\": 10\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/lessons/1/submit",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "lessons", "1", "submit"]
            }
          }
