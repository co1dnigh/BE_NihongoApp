{
  "permissions": {
    "allow": [
      "Bash(docker exec *)",
      "Bash(netstat -ano)",
      "Bash(findstr :8080)",
      "PowerShell(taskkill /PID 16444 /F)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/graph-gate.mjs",
            "shell": "bash",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__codebase-memory-mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/graph-gate.mjs",
            "shell": "bash",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
